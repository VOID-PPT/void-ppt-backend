# App Configuration
APP_NAME="Void API"
APP_VERSION="0.1.0"
ENVIRONMENT="local"
DEBUG=true
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# PostgreSQL Database (asyncpg)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/void_db"
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# Auth Configuration
AUTH_JWT_SECRET="generate-a-secure-random-32-byte-hex-key-here"
AUTH_JWT_ALG="HS256"
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=14
